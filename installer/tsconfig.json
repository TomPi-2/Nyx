{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "$lib/*": ["../ui/src/lib/*"],
      "$theme/*": ["../ui/src/theme/*"],
      "$shape/*": ["../ui/src/overlay/shape/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
